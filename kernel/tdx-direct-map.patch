+/*
+ * Call only after TDH.MEM.PAGE.ADD or AUG has succeeded, and only for
+ * that guest page. CLFLUSHOPT is a load and page-faults when the direct
+ * map is not present, so the flush stays above the unmap. The 4K split
+ * already happened on a sleepable path. This runs under mmu_lock and
+ * must not allocate.
+ */
+static atomic64_t tdx_hide_ok;
+static atomic64_t tdx_hide_fail;
+static atomic64_t tdx_unshield_ok;
+static atomic64_t tdx_unshield_fail;
+
+static bool tdx_direct_leaf_is_4k(unsigned long addr)
+{
+	unsigned int level;
+	pte_t *pte;
+
+	if (!addr)
+		return false;
+	pte = lookup_address(addr, &level);
+	return pte && level == PG_LEVEL_4K;
+}
+
+static void tdx_hide_private_page(struct page *page)
+{
+	unsigned long addr = (unsigned long)page_address(page);
+
+	tdx_clflush_page(page);
+	if (!tdx_direct_leaf_is_4k(addr)) {
+		atomic64_inc(&tdx_hide_fail);
+		return;
+	}
+	if (set_direct_map_invalid_noflush(page)) {
+		atomic64_inc(&tdx_hide_fail);
+		return;
+	}
+	flush_tlb_kernel_range(addr, addr + PAGE_SIZE);
+	atomic64_inc(&tdx_hide_ok);
+}
+
+int tdx_unshield_private_page(struct page *page)
+{
+	unsigned long addr = (unsigned long)page_address(page);
+	int r;
+
+	if (!tdx_direct_leaf_is_4k(addr)) {
+		atomic64_inc(&tdx_unshield_fail);
+		return -EINVAL;
+	}
+	r = set_direct_map_default_noflush(page);
+	if (r) {
+		atomic64_inc(&tdx_unshield_fail);
+		return r;
+	}
+	flush_tlb_kernel_range(addr, addr + PAGE_SIZE);
+	atomic64_inc(&tdx_unshield_ok);
+	return 0;
+}
+EXPORT_SYMBOL_FOR_KVM(tdx_unshield_private_page);
+
+static int tdx_direct_map_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "hide_ok %lld\nhide_fail %lld\nunshield_ok %lld\nunshield_fail %lld\n",
+		   atomic64_read(&tdx_hide_ok), atomic64_read(&tdx_hide_fail),
+		   atomic64_read(&tdx_unshield_ok), atomic64_read(&tdx_unshield_fail));
+	return 0;
+}
+
+static int tdx_direct_map_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, tdx_direct_map_show, NULL);
+}
+
+static const struct proc_ops tdx_direct_map_ops = {
+	.proc_open = tdx_direct_map_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+
+static int __init tdx_direct_map_proc(void)
+{
+	proc_create("tdx_direct_map", 0444, NULL, &tdx_direct_map_ops);
+	return 0;
+}
+late_initcall(tdx_direct_map_proc);
